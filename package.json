{
  "name": "open-acrobat",
  "version": "1.0.0",
  "description": "Adobe Acrobat Clone for Fedora Linux & Cross-Platform",
  "private": true,
  "type": "module",
  "main": "electron-main.js",
  "author": {
    "name": "Corazonpirate27",
    "email": "arogyabaral123@gmail.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "dist": "vite build && electron-builder --linux AppImage rpm"
  },
  "build": {
    "appId": "com.corazonpirate27.openacrobat",
    "productName": "Open Acrobat",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "package.json"
    ],
    "linux": {
      "category": "Office"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide": "^1.28.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108"
  }
}
